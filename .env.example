DATABASE_URL=postgres://postgres:password@localhost:5432/sarpras_db
BETTER_AUTH_SECRET=your_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Base URL untuk tautan di template WhatsApp (tracking URL & admin approval)
APP_BASE_URL=http://localhost:3000

# Fonnte WhatsApp Gateway Configuration
# Dapatkan token dari https://md.fonnte.com/
FONNTE_API_TOKEN=your_fonnte_api_token_here

# Nomor WhatsApp Admin / Operator / Group ID untuk menerima notifikasi pengajuan baru
# Format: 6281234567890 atau WhatsApp Group ID (contoh: 120363xxx@g.us)
# Bisa juga multi-nomor dengan koma: 6281234567890,628987654321
FONNTE_ADMIN_TARGET=6281234567890

# Set ke "true" jika ingin memaksa mode mock console meskipun FONNTE_API_TOKEN diisi
# FONNTE_MOCK=false
