# --- Application Ports ---
APP_PORT=3002
DB_PORT=5435

# --- Better Auth Security ---
BETTER_AUTH_SECRET=f9b4c0274e1d4b8e8f8e8a7c2b4d6e9f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d
BETTER_AUTH_URL=http://localhost:3002

# --- Google OAuth Credentials ---
# Dapatkan dari Google Cloud Console: Credentials -> OAuth 2.0 Client IDs
# Redirect URI: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Initial Admin Setup ---
# Email Google atau email akun admin yang otomatis diberikan role Administrator
ADMIN_DEFAULT_EMAIL=admin@ppkasn.go.id
ADMIN_DEFAULT_PASSWORD=Password123!

# --- PostgreSQL Container Configuration ---
POSTGRES_USER=sarpras
POSTGRES_PASSWORD=sarpras_password
POSTGRES_DB=sarpras_db
